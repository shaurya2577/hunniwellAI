# Copy to .env (gitignored) and fill in. TWO .env files are read:
#   - repo-root .env            -> read by the kg/ package (Supabase + embeddings)
#   - ai/airtable_ingest/.env   -> read by the ingest tool (Anthropic + Airtable)
# For a full `ingest --kg` run, populate both (putting ANTHROPIC_API_KEY in both is fine).
# To ONLY run the kg/ test suite you need NO secrets — see kg/README.md (local Postgres via Docker).

# --- AI ingest (ai/airtable_ingest) ---
ANTHROPIC_API_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=
# CompanyFiles root (the OneDrive decks). Defaults to ~/Documents/Hunniwell if unset.
HUNNIWELL_COMPANYFILES_ROOT=

# --- Knowledge base (kg/) ---
# Supabase Postgres. Use the Session-pooler URI (IPv4); URL-encode special chars in the
# password (e.g. '@' -> '%40'). Leave blank if you only use a local Postgres for testing.
SUPABASE_DB_URL=
# Embedding backend: "ollama" (local, free, needs `ollama pull mxbai-embed-large`) or
# "voyage" (needs VOYAGE_API_KEY). Both emit 1024-dim vectors.
EMBEDDINGS_PROVIDER=ollama
VOYAGE_API_KEY=
# Optional local-embedding overrides (defaults shown):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large

# --- Tests only ---
# Local Postgres+pgvector for the kg/ test suite. The conftest defaults to this exact value
# if unset, so you usually don't need to set it. No secret involved.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hunniwell_test
